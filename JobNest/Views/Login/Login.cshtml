@model JobNest.Models.LoginClass

@{
    Layout = null;
    ViewBag.Title = "Sign In | JobNest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap CSS -->
    @Styles.Render("~/Content/css")

    <style>
        :root {
            --primary-emerald: #10b981;
            --emerald-glow: rgba(16, 185, 129, 0.35);
            --primary-blue: #3b82f6;
            --blue-glow: rgba(59, 130, 246, 0.35);
            --bg-dark: #090d16;
            --card-bg: rgba(17, 24, 39, 0.75);
            --card-border: rgba(255, 255, 255, 0.1);
            --text-heading: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(255, 255, 255, 0.05);
            --input-border: rgba(255, 255, 255, 0.12);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(16, 185, 129, 0.12) 0%, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(59, 130, 246, 0.12) 0%, transparent 45%),
                radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0.8) 0%, transparent 100%);
            color: #e2e8f0;
            margin: 0;
            padding: 0 !important;
            padding-top: 0 !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Ambient Glowing Background Orbs */
        .ambient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 1;
        }

        .orb-1 {
            top: 10%;
            left: 10%;
            width: 350px;
            height: 350px;
            background: rgba(16, 185, 129, 0.15);
        }

        .orb-2 {
            bottom: 10%;
            right: 10%;
            width: 380px;
            height: 380px;
            background: rgba(59, 130, 246, 0.15);
        }

        /* Main Floating Master Glass Card */
        .master-auth-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 960px;
            margin: 20px auto;
            padding: 0 16px;
        }

        .glass-auth-card {
            background: var(--card-bg);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--card-border);
            border-radius: 28px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.5), 0 0 30px rgba(255, 255, 255, 0.02);
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        /* Left Hero Showcase Side */
        .auth-hero-side {
            flex: 1;
            min-width: 340px;
            background: linear-gradient(160deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.6) 100%);
            padding: 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-right: 1px solid var(--card-border);
            position: relative;
        }

        .brand-header-link {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
            margin-bottom: 30px;
        }

        .brand-icon-box {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 20px;
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        }

        .brand-text {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.6px;
        }

        .brand-text span {
            color: var(--primary-emerald);
        }

        .hero-main-content h1 {
            font-size: 30px;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.25;
            margin: 0 0 14px 0;
            letter-spacing: -0.6px;
        }

        .hero-main-content p {
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.6;
            margin: 0 0 32px 0;
        }

        /* Dynamic Role Showcase Widget */
        .dynamic-role-widget {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px;
            transition: var(--transition);
        }

        .widget-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 4px 10px;
            border-radius: 20px;
            margin-bottom: 10px;
        }

        .widget-badge.candidate {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .widget-badge.employer {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.25);
        }

        .widget-title {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            margin: 0 0 4px 0;
        }

        .widget-desc {
            font-size: 12.5px;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.4;
        }

        /* Features List */
        .hero-features-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 24px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #cbd5e1;
        }

        .feature-item i {
            color: var(--primary-emerald);
            font-size: 14px;
        }

        /* Right Form Side */
        .auth-form-side {
            flex: 1.1;
            min-width: 340px;
            padding: 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: rgba(15, 23, 42, 0.4);
        }

        .form-header {
            margin-bottom: 24px;
        }

        .form-header h2 {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-heading);
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

        .form-header p {
            font-size: 13.5px;
            color: var(--text-muted);
            margin: 0;
        }

        /* Segmented Role Switcher */
        .role-segmented-control {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 4px;
            display: flex;
            gap: 4px;
            margin-bottom: 26px;
        }

        .segmented-btn {
            flex: 1;
            padding: 10px 12px;
            font-size: 12.5px;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .segmented-btn:hover {
            color: #ffffff;
        }

        .segmented-btn.active.candidate-active {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            box-shadow: 0 4px 14px var(--emerald-glow);
        }

        .segmented-btn.active.employer-active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: #ffffff;
            box-shadow: 0 4px 14px var(--blue-glow);
        }

        /* Form Inputs */
        .input-block {
            width: 100%;
            margin-bottom: 22px;
        }

        .input-block label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 700;
            color: #cbd5e1;
            margin-bottom: 8px;
        }

        .forgot-link {
            color: var(--primary-blue);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none !important;
            transition: var(--transition);
        }

        .forgot-link:hover {
            color: #60a5fa;
            text-decoration: underline !important;
        }

        .input-field-wrapper {
            position: relative;
            width: 100%;
            display: flex;
            align-items: center;
        }

        .input-field-wrapper i.field-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 16px;
            pointer-events: none;
            transition: var(--transition);
            z-index: 5;
        }

        .dark-input {
            width: 100% !important;
            max-width: 100% !important;
            height: 56px;
            padding: 12px 50px 12px 48px;
            font-size: 15px;
            font-weight: 500;
            color: #ffffff;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 14px;
            outline: none;
            transition: var(--transition);
        }

        .dark-input::placeholder {
            color: #64748b;
        }

        .dark-input:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--primary-emerald);
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
        }

        .input-field-wrapper:focus-within i.field-icon {
            color: var(--primary-emerald);
        }

        .pwd-toggle-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 16px;
            padding: 6px 8px;
            border-radius: 8px;
            transition: var(--transition);
            z-index: 10;
        }

        .pwd-toggle-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        /* Error Banner */
        .dark-alert-danger {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: #fca5a5;
        }

        .dark-alert-danger i {
            font-size: 18px;
            margin-top: 1px;
            flex-shrink: 0;
            color: #ef4444;
        }

        .dark-alert-danger ul {
            margin: 0;
            padding-left: 16px;
            font-size: 12.5px;
        }

        .field-validation-error {
            color: #f87171;
            font-size: 12px;
            font-weight: 600;
            margin-top: 6px;
            display: block;
        }

        /* Primary Action Button */
        .btn-submit-action {
            width: 100%;
            height: 52px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            font-size: 15.5px;
            font-weight: 700;
            border: none;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 25px -5px var(--emerald-glow);
            cursor: pointer;
            transition: var(--transition);
            margin-top: 8px;
        }

        .btn-submit-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -5px var(--emerald-glow);
            color: #ffffff;
        }

        /* Sign-Up Prompt Footer Box */
        .register-footer-prompt {
            margin-top: 26px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
        }

        .register-footer-prompt p {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0 0 12px 0;
        }

        .register-links-flex {
            display: flex;
            gap: 10px;
        }

        .reg-link-btn {
            flex: 1;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 700;
            text-decoration: none !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: var(--transition);
        }

        .reg-link-btn.candidate {
            background: rgba(16, 185, 129, 0.12);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .reg-link-btn.candidate:hover {
            background: rgba(16, 185, 129, 0.22);
            transform: translateY(-1px);
        }

        .reg-link-btn.employer {
            background: rgba(59, 130, 246, 0.12);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.25);
        }

        .reg-link-btn.employer:hover {
            background: rgba(59, 130, 246, 0.22);
            transform: translateY(-1px);
        }

        /* Responsive Mobile Breakpoint */
        @@media (max-width: 991px) {
            .glass-auth-card {
                flex-direction: column-reverse;
            }
            .auth-hero-side {
                border-right: none;
                border-top: 1px solid var(--card-border);
                padding: 32px 24px;
            }
            .auth-form-side {
                padding: 36px 24px;
            }
            .register-links-flex {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>

    <!-- Ambient Glowing Orbs -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>

    <!-- Main Floating Glass Container -->
    <div class="master-auth-container">
        <div class="glass-auth-card">
            
            <!-- Left Hero Showcase Panel -->
            <div class="auth-hero-side">
                <div>
                    <a href="@Url.Action("Index", "Home")" class="brand-header-link">
                        <div class="brand-icon-box">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>
                        <span class="brand-text">Job<span>Nest</span></span>
                    </a>

                    <div class="hero-main-content">
                        <h1>One Gateway to Unlimited Opportunities</h1>
                        <p>
                            Connect with verified candidates or apply to top global hiring partners. Access your personalized recruitment suite.
                        </p>
                    </div>

                    <!-- Dynamic Role Showcase Box -->
                    <div class="dynamic-role-widget">
                        <div class="widget-badge candidate" id="widgetRoleBadge">
                            <i class="fa-solid fa-user-graduate"></i> Candidate Portal
                        </div>
                        <div class="widget-title" id="widgetRoleTitle">Job Seekers &amp; Candidates</div>
                        <p class="widget-desc" id="widgetRoleDesc">
                            Browse active vacancies, submit applications, track recruiters, and update candidate profile.
                        </p>
                    </div>

                    <!-- Key Platform Features -->
                    <div class="hero-features-list">
                        <div class="feature-item">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Verified Employer Listings &amp; Direct Apply</span>
                        </div>
                        <div class="feature-item">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Smart Resume Matching Engine</span>
                        </div>
                        <div class="feature-item">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Real-Time Application Status Updates</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Authentication Form Panel -->
            <div class="auth-form-side">
                <div>
                    <div class="form-header">
                        <h2>Sign In</h2>
                        <p>Welcome back! Enter your login credentials to continue.</p>
                    </div>

                    <!-- Segmented Role Switcher -->
                    <div class="role-segmented-control">
                        <button type="button" class="segmented-btn active candidate-active" id="btnRoleCandidate" onclick="setRoleContext('candidate')">
                            <i class="fa-solid fa-user"></i> Candidate
                        </button>
                        <button type="button" class="segmented-btn" id="btnRoleEmployer" onclick="setRoleContext('employer')">
                            <i class="fa-solid fa-building"></i> Employer
                        </button>
                    </div>

                    <!-- Form posting to LoginController -->
                    @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { role = "form", id = "loginForm", autocomplete = "on" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- ModelState Error Alert Box -->
                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="dark-alert-danger" aria-live="assertive">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <div>
                                    <strong style="font-size: 13.5px; display: block; margin-bottom: 2px;">Authentication Error</strong>
                                    @Html.ValidationSummary(false, "", new { style = "margin-bottom: 0;" })
                                </div>
                            </div>
                        }

                        <!-- Info Message if Model.msg is set -->
                        if (Model != null && !string.IsNullOrEmpty(Model.msg))
                        {
                            <div class="alert alert-info" style="border-radius: 12px; font-size: 13px; margin-bottom: 20px; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd;">
                                <i class="fa-solid fa-circle-info"></i> @Model.msg
                            </div>
                        }

                        <!-- Username Input Field -->
                        <div class="input-block">
                            <label for="Username">
                                <span>Username</span>
                            </label>
                            <div class="input-field-wrapper">
                                <i class="fa-solid fa-user field-icon" id="userIcon"></i>
                                @Html.TextBoxFor(m => m.Username, new { 
                                    @class = "dark-input", 
                                    placeholder = "Enter your username", 
                                    autocomplete = "username"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Username)
                        </div>

                        <!-- Password Input Field -->
                        <div class="input-block">
                            <label for="Password">
                                <span>Password</span>
                                <a href="#" class="forgot-link" onclick="alert('Please contact system administrator to recover your password.'); return false;">
                                    Forgot Password?
                                </a>
                            </label>
                            <div class="input-field-wrapper">
                                <i class="fa-solid fa-lock field-icon" id="lockIcon"></i>
                                @Html.PasswordFor(m => m.Password, new { 
                                    @class = "dark-input", 
                                    placeholder = "Enter your password", 
                                    id = "loginPassword",
                                    autocomplete = "current-password"
                                })
                                <button type="button" class="pwd-toggle-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">
                                    <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password)
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-submit-action" id="btnSubmitForm">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In to Portal
                        </button>
                    }

                    <!-- Registration Options Footer -->
                    <div class="register-footer-prompt">
                        <p>Don't have an account yet?</p>
                        <div class="register-links-flex">
                            <a href="@Url.Action("AddEmployee", "Employee")" class="reg-link-btn candidate">
                                <i class="fa-solid fa-user-plus"></i> Candidate Register
                            </a>
                            <a href="@Url.Action("AddCompany", "Company")" class="reg-link-btn employer">
                                <i class="fa-solid fa-building-circle-check"></i> Company Register
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- jQuery & ASP.NET Unobtrusive Validation Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Interactive Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Password Visibility Toggle
            var toggleBtn = document.getElementById('togglePasswordBtn');
            var passwordInput = document.getElementById('loginPassword');
            var toggleIcon = document.getElementById('togglePasswordIcon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        toggleIcon.classList.remove('fa-eye');
                        toggleIcon.classList.add('fa-eye-slash');
                    } else {
                        passwordInput.type = 'password';
                        toggleIcon.classList.remove('fa-eye-slash');
                        toggleIcon.classList.add('fa-eye');
                    }
                });
            }
        });

        // Dynamic Role Context Switcher
        function setRoleContext(role) {
            var btnCand = document.getElementById('btnRoleCandidate');
            var btnEmp = document.getElementById('btnRoleEmployer');
            var submitBtn = document.getElementById('btnSubmitForm');
            var roleBadge = document.getElementById('widgetRoleBadge');
            var roleTitle = document.getElementById('widgetRoleTitle');
            var roleDesc = document.getElementById('widgetRoleDesc');
            var userIcon = document.getElementById('userIcon');

            if (role === 'candidate') {
                btnCand.classList.add('active', 'candidate-active');
                btnEmp.classList.remove('active', 'employer-active');
                
                if (submitBtn) {
                    submitBtn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                    submitBtn.style.boxShadow = '0 10px 25px -5px rgba(16, 185, 129, 0.35)';
                }

                if (roleBadge) {
                    roleBadge.className = 'widget-badge candidate';
                    roleBadge.innerHTML = '<i class="fa-solid fa-user-graduate"></i> Candidate Portal';
                }
                if (roleTitle) roleTitle.innerText = 'Job Seekers & Candidates';
                if (roleDesc) roleDesc.innerText = 'Browse active vacancies, submit applications, track recruiters, and update candidate profile.';

            } else {
                btnEmp.classList.add('active', 'employer-active');
                btnCand.classList.remove('active', 'candidate-active');

                if (submitBtn) {
                    submitBtn.style.background = 'linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)';
                    submitBtn.style.boxShadow = '0 10px 25px -5px rgba(59, 130, 246, 0.35)';
                }

                if (roleBadge) {
                    roleBadge.className = 'widget-badge employer';
                    roleBadge.innerHTML = '<i class="fa-solid fa-building-user"></i> Employer Portal';
                }
                if (roleTitle) roleTitle.innerText = 'Employers & Companies';
                if (roleDesc) roleDesc.innerText = 'Post job openings, review candidate resumes, manage applications, and hire top talent.';
            }
        }
    </script>
</body>
</html>
