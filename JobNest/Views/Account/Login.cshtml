@model JobNest.Models.LoginClass

@{
    Layout = null;
    ViewBag.Title = "Sign In | JobNest - Candidate & Employer Portal";
    bool hasGeneralError = ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap CSS -->
    @Styles.Render("~/Content/css")

    <style>
        /* ========================================
           CSS VARIABLES & DESIGN SYSTEM
           ======================================== */
        :root {
            --green: #059669;
            --green-hover: #047857;
            --green-light: #ecfdf5;
            --green-border: #a7f3d0;
            --green-glow: rgba(5, 150, 105, 0.16);
            --green-stat: #34d399;
            --green-grad: linear-gradient(135deg, #059669 0%, #10b981 100%);

            --blue: #185adb;
            --blue-hover: #1041a3;
            --blue-light: #eff6ff;
            --blue-border: #bfdbfe;
            --blue-glow: rgba(24, 90, 219, 0.16);
            --blue-stat: #60a5fa;
            --blue-grad: linear-gradient(135deg, #185adb 0%, #2563eb 100%);

            --dark: #0f172a;
            --text-main: #334155;
            --text-muted: #64748b;
            --border-subtle: #e2e8f0;
            --bg-right: #f8fafc;
        }

        /* Role: Candidate Active Theming */
        body.role-candidate {
            --active: #059669;
            --active-hover: #047857;
            --active-light: #ecfdf5;
            --active-border: #a7f3d0;
            --active-glow: rgba(5, 150, 105, 0.16);
            --active-grad: linear-gradient(135deg, #059669 0%, #10b981 100%);
            --active-shadow: rgba(5, 150, 105, 0.32);
            --mesh-primary: rgba(16, 185, 129, 0.45);
            --mesh-secondary: rgba(52, 211, 153, 0.3);
        }

        /* Role: Company / Employer Active Theming */
        body.role-company {
            --active: #185adb;
            --active-hover: #1041a3;
            --active-light: #eff6ff;
            --active-border: #bfdbfe;
            --active-glow: rgba(24, 90, 219, 0.16);
            --active-grad: linear-gradient(135deg, #185adb 0%, #2563eb 100%);
            --active-shadow: rgba(24, 90, 219, 0.32);
            --mesh-primary: rgba(37, 99, 235, 0.45);
            --mesh-secondary: rgba(96, 165, 250, 0.3);
        }

        * {
            box-sizing: border-box;
        }

        input, select, textarea {
            max-width: 100% !important;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: #ffffff;
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
        }

        /* ========================================
           SPLIT SCREEN CONTAINER (Balanced 50/50 Grid)
           ======================================== */
        .split-auth-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ========================================
           LEFT PANEL — Brand & Narrative Hub
           ======================================== */
        .left-brand-panel {
            width: 50%;
            min-height: 100vh;
            background: linear-gradient(165deg, #0b1120 0%, #111a33 55%, #0d152a 100%);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 36px 48px;
            z-index: 1;
        }

        /* Subtle Background Dot Texture */
        .left-brand-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 26px 26px;
            z-index: 1;
            pointer-events: none;
        }

        /* Ambient Glowing Blobs */
        .mesh-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            transition: background 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
            z-index: 0;
        }

        .mesh-orb-top {
            width: 440px;
            height: 440px;
            top: -90px;
            right: -60px;
            background: radial-gradient(circle, var(--mesh-primary) 0%, transparent 70%);
            animation: floatOrbTop 14s ease-in-out infinite alternate;
        }

        .mesh-orb-bottom {
            width: 380px;
            height: 380px;
            bottom: -60px;
            left: -40px;
            background: radial-gradient(circle, var(--mesh-secondary) 0%, transparent 70%);
            animation: floatOrbBottom 12s ease-in-out infinite alternate;
        }

        @@keyframes floatOrbTop {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(30px, -20px) scale(1.1); }
        }

        @@keyframes floatOrbBottom {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(-20px, -30px) scale(1.08); }
        }

        /* Left Header: Logo & Status Badge (Locked at Top) */
        .left-top-bar {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 44px;
        }

        .brand-logo-link {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
        }

        .brand-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #059669 0%, #185adb 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 18px;
            box-shadow: 0 4px 14px rgba(5, 150, 105, 0.28);
        }

        .brand-logo-text {
            font-size: 23px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .brand-logo-accent {
            transition: color 0.4s ease;
        }

        body.role-candidate .brand-logo-accent { color: var(--green-stat); }
        body.role-company .brand-logo-accent { color: var(--blue-stat); }

        .system-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
            color: #cbd5e1;
            backdrop-filter: blur(8px);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            transition: background-color 0.4s ease, box-shadow 0.4s ease;
        }

        body.role-candidate .status-dot {
            background-color: var(--green-stat);
            box-shadow: 0 0 8px var(--green-stat);
        }

        body.role-company .status-dot {
            background-color: var(--blue-stat);
            box-shadow: 0 0 8px var(--blue-stat);
        }

        /* Left Body Content: Aligned Narrative & Cards */
        .left-center-body {
            position: relative;
            z-index: 2;
            margin: auto 0;
            padding: 32px 0;
            max-width: 520px;
            width: 100%;
        }

        .left-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        body.role-candidate .left-badge {
            background: rgba(5, 150, 105, 0.18);
            color: var(--green-stat);
            border: 1px solid rgba(5, 150, 105, 0.3);
        }

        body.role-company .left-badge {
            background: rgba(24, 90, 219, 0.18);
            color: var(--blue-stat);
            border: 1px solid rgba(24, 90, 219, 0.3);
        }

        .left-headline {
            font-size: 34px;
            font-weight: 900;
            color: #ffffff;
            line-height: 1.22;
            letter-spacing: -1px;
            margin: 0 0 14px 0;
        }

        .left-description {
            font-size: 15px;
            color: #94a3b8;
            line-height: 1.6;
            margin: 0 0 28px 0;
        }

        /* Feature Pillars (3 Value Props) */
        .feature-pillars-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 28px;
        }

        .feature-pillar-item {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 12px;
            padding: 12px 16px;
            backdrop-filter: blur(8px);
            transition: all 0.3s ease;
        }

        .feature-pillar-item:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateX(4px);
        }

        .pillar-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
            transition: background 0.3s, color 0.3s;
        }

        body.role-candidate .pillar-icon-box {
            background: rgba(5, 150, 105, 0.2);
            color: var(--green-stat);
        }

        body.role-company .pillar-icon-box {
            background: rgba(24, 90, 219, 0.2);
            color: var(--blue-stat);
        }

        .pillar-text-group {
            flex: 1;
        }

        .pillar-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #f1f5f9;
            margin-bottom: 2px;
        }

        .pillar-sub {
            font-size: 12px;
            color: #94a3b8;
        }

        /* Trust Stats Row */
        .trust-stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 14px 10px;
            text-align: center;
            backdrop-filter: blur(6px);
            transition: border-color 0.4s;
        }

        body.role-candidate .stat-box { border-color: rgba(5, 150, 105, 0.2); }
        body.role-company .stat-box { border-color: rgba(24, 90, 219, 0.2); }

        .stat-number-val {
            font-size: 22px;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 5px;
            transition: color 0.4s;
        }

        body.role-candidate .stat-number-val { color: var(--green-stat); }
        body.role-company .stat-number-val { color: var(--blue-stat); }

        .stat-title-lbl {
            font-size: 11px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 600;
        }

        /* Left Bottom Footer */
        .left-bottom-bar {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.4);
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding-top: 20px;
        }

        .left-bottom-bar a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s;
        }

        .left-bottom-bar a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

        /* ========================================
           RIGHT PANEL — Crisp Elevated Form Area
           ======================================== */
        .right-form-panel {
            width: 50%;
            min-height: 100vh;
            background-color: var(--bg-right);
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 24px 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px 48px;
            position: relative;
        }

        /* Form Card Centering Container */
        .form-card-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        /* Elevated Auth Card (Fixes the Dead Space Problem) */
        .auth-elevated-card {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08), 
                        0 1px 3px rgba(0, 0, 0, 0.02);
            padding: 38px 36px 32px;
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }

        body.role-candidate .auth-elevated-card {
            border-color: rgba(167, 243, 208, 0.8);
            box-shadow: 0 20px 40px -15px rgba(5, 150, 105, 0.1), 
                        0 1px 3px rgba(0, 0, 0, 0.02);
        }

        body.role-company .auth-elevated-card {
            border-color: rgba(191, 219, 254, 0.8);
            box-shadow: 0 20px 40px -15px rgba(24, 90, 219, 0.1), 
                        0 1px 3px rgba(0, 0, 0, 0.02);
        }

        /* Card Header & Badges */
        .card-header-block {
            margin-bottom: 22px;
        }

        .portal-role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
        }

        body.role-candidate .portal-role-badge {
            background-color: var(--green-light);
            color: var(--green);
            border: 1px solid var(--green-border);
        }

        body.role-company .portal-role-badge {
            background-color: var(--blue-light);
            color: var(--blue);
            border: 1px solid var(--blue-border);
        }

        .card-main-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--dark);
            letter-spacing: -0.6px;
            margin: 0 0 6px 0;
        }

        .card-sub-title {
            font-size: 13.5px;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.45;
        }

        /* Role Switcher (Equal Segments, High Contrast) */
        .role-switch-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 24px;
        }

        .role-switch-tile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 12px;
            border: 1.5px solid var(--border-subtle);
            background: #ffffff;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            text-align: left;
            outline: none;
        }

        .role-switch-tile:hover {
            border-color: #cbd5e1;
            background: #f8fafc;
            transform: translateY(-1px);
        }

        .tile-icon-avatar {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
            transition: all 0.22s;
        }

        .cand-avatar { background: var(--green-light); color: var(--green); }
        .comp-avatar { background: var(--blue-light); color: var(--blue); }

        .tile-texts { flex: 1; min-width: 0; }
        .tile-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--dark);
            line-height: 1.2;
            margin-bottom: 2px;
        }
        .tile-tag {
            font-size: 11px;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Active Candidate Tile */
        .role-switch-tile.active-candidate {
            border-color: var(--green);
            background: var(--green-light);
            box-shadow: 0 4px 12px var(--green-glow);
        }

        /* Active Company Tile */
        .role-switch-tile.active-company {
            border-color: var(--blue);
            background: var(--blue-light);
            box-shadow: 0 4px 12px var(--blue-glow);
        }

        /* Error Toast Banner */
        .auth-error-banner {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-left: 4px solid #ef4444;
            border-radius: 12px;
            margin-bottom: 18px;
            animation: shakeBanner 0.35s ease-in-out;
        }

        .auth-error-banner .err-icon {
            color: #dc2626;
            font-size: 15px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .auth-error-banner .err-content { flex: 1; }
        .auth-error-banner .err-heading {
            font-size: 12.5px;
            font-weight: 700;
            color: #991b1b;
            margin-bottom: 2px;
        }

        .auth-error-banner .validation-summary-errors ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .auth-error-banner .validation-summary-errors li {
            font-size: 12px;
            color: #b91c1c;
            font-weight: 500;
        }

        .btn-dismiss-err {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 16px;
            padding: 0;
            line-height: 1;
        }

        .btn-dismiss-err:hover { color: #475569; }

        @@keyframes shakeBanner {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        /* Info Alert */
        .auth-info-banner {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            background: var(--blue-light);
            border: 1px solid var(--blue-border);
            border-radius: 12px;
            margin-bottom: 18px;
            font-size: 12.5px;
            color: #1e40af;
        }

        /* Form Input Field Groups */
        .field-unit {
            margin-bottom: 16px;
        }

        .field-label-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .field-label-line label,
        .field-unit > label {
            font-size: 13px;
            font-weight: 700;
            color: var(--dark);
            margin: 0 0 6px 0;
            cursor: pointer;
            display: block;
        }

        .field-label-line label { margin-bottom: 0; }

        .link-forgot-pass {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none !important;
            transition: color 0.2s;
            cursor: pointer;
        }

        .link-forgot-pass:hover {
            color: var(--active);
            text-decoration: underline !important;
        }

        .field-input-box {
            display: flex;
            align-items: center;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
        }

        .field-input-box:focus-within {
            border-color: var(--active);
            background: #ffffff;
            box-shadow: 0 0 0 3.5px var(--active-glow);
        }

        .field-lead-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            flex-shrink: 0;
            color: #94a3b8;
            font-size: 14px;
            transition: color 0.2s;
        }

        .field-input-box:focus-within .field-lead-icon {
            color: var(--active);
        }

        .field-control {
            flex: 1;
            border: none !important;
            background: transparent !important;
            padding: 12px 14px 12px 0 !important;
            font-size: 14px;
            font-family: inherit;
            font-weight: 500;
            color: var(--dark);
            outline: none !important;
            box-shadow: none !important;
            height: auto !important;
        }

        .field-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .btn-eye-toggle {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 14px;
            padding: 10px 14px;
            transition: color 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .btn-eye-toggle:hover { color: #334155; }

        .field-validation-error {
            color: #ef4444;
            font-size: 11.5px;
            font-weight: 600;
            margin-top: 4px;
            display: block;
        }

        .input-validation-error {
            border-color: #ef4444 !important;
        }

        /* Forgot Password Assistance Card */
        .forgot-help-card {
            display: none;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 16px;
            font-size: 12.5px;
            color: #1e40af;
            line-height: 1.5;
            animation: fadeInCard 0.2s ease;
        }

        .forgot-help-close {
            float: right;
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 15px;
            padding: 0;
            line-height: 1;
        }

        .forgot-help-close:hover { color: #0f172a; }

        @@keyframes fadeInCard {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Primary Submit Button */
        .btn-action-submit {
            width: 100%;
            padding: 13px 20px;
            border: none;
            border-radius: 12px;
            color: #ffffff;
            font-family: inherit;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 6px;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            background: var(--active-grad);
            box-shadow: 0 6px 18px var(--active-shadow);
        }

        .btn-action-submit:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 8px 24px var(--active-shadow);
            filter: brightness(1.05);
        }

        .btn-action-submit:active {
            transform: translateY(0);
        }

        .btn-action-submit i {
            font-size: 12px;
            transition: transform 0.2s;
        }

        .btn-action-submit:hover i {
            transform: translateX(3px);
        }

        /* Clean Register Gateway */
        .register-gateway-block {
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid var(--border-subtle);
            text-align: center;
        }

        .register-prompt-lbl {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 12px;
        }

        .reg-action-buttons {
            display: flex;
            gap: 8px;
        }

        .reg-tile-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 12px;
            border: 1.5px solid var(--border-subtle);
            border-radius: 11px;
            font-size: 12px;
            font-weight: 700;
            color: var(--dark);
            text-decoration: none !important;
            background: #ffffff;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .reg-tile-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            opacity: 0;
            z-index: 0;
            transition: opacity 0.22s;
        }

        .reg-tile-btn span,
        .reg-tile-btn i {
            position: relative;
            z-index: 1;
        }

        .reg-tile-btn .btn-arrow-arr {
            font-size: 9px;
            opacity: 0;
            transform: translateX(-4px);
            transition: all 0.22s;
        }

        /* Candidate Register Hover */
        .reg-tile-btn.reg-cand::before {
            background: var(--green-grad);
        }

        .reg-tile-btn.reg-cand:hover {
            border-color: var(--green);
            color: #ffffff !important;
            transform: translateY(-1.5px);
            box-shadow: 0 4px 14px rgba(5, 150, 105, 0.22);
        }

        .reg-tile-btn.reg-cand:hover::before { opacity: 1; }
        .reg-tile-btn.reg-cand:hover .btn-arrow-arr { opacity: 1; transform: translateX(0); }

        /* Company Register Hover */
        .reg-tile-btn.reg-comp::before {
            background: var(--blue-grad);
        }

        .reg-tile-btn.reg-comp:hover {
            border-color: var(--blue);
            color: #ffffff !important;
            transform: translateY(-1.5px);
            box-shadow: 0 4px 14px rgba(24, 90, 219, 0.22);
        }

        .reg-tile-btn.reg-comp:hover::before { opacity: 1; }
        .reg-tile-btn.reg-comp:hover .btn-arrow-arr { opacity: 1; transform: translateX(0); }

        /* Right Bottom Footer */
        .right-bottom-bar {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 16px;
        }

        /* ========================================
           RESPONSIVE BREAKPOINTS
           ======================================== */
        @@media (max-width: 1024px) {
            .left-brand-panel { width: 50%; padding: 30px; }
            .right-form-panel { width: 50%; padding: 30px; }
            .left-headline { font-size: 28px; }
        }

        @@media (max-width: 860px) {
            .split-auth-container { flex-direction: column; }
            .left-brand-panel {
                width: 100%;
                min-height: auto;
                padding: 28px 24px;
            }
            .left-center-body { display: none; }
            .left-bottom-bar { display: none; }
            .right-form-panel {
                width: 100%;
                min-height: auto;
                padding: 24px 20px 36px;
            }
            .form-card-wrapper { padding: 10px 0; }
            .auth-elevated-card { padding: 28px 22px; }
        }

        @@media (max-width: 480px) {
            .role-switch-grid { grid-template-columns: 1fr; }
            .reg-action-buttons { flex-direction: column; }
            .card-main-title { font-size: 22px; }
        }
    </style>
</head>

<body class="role-candidate">

    <div class="split-auth-container">

        <!-- ==========================================
             LEFT PANEL: Brand, Narrative & Value Props
             ========================================== -->
        <aside class="left-brand-panel">
            <!-- Glowing Orbs -->
            <div class="mesh-orb mesh-orb-top"></div>
            <div class="mesh-orb mesh-orb-bottom"></div>

            <!-- Top Header: Aligned at Top -->
            <div class="left-top-bar">
                <a href="@Url.Action("Index", "Home")" class="brand-logo-link">
                    <div class="brand-logo-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <span class="brand-logo-text">Job<span class="brand-logo-accent">Nest</span></span>
                </a>
                <div class="system-status-pill">
                    <span class="status-dot"></span>
                    <span id="statusPortalText">Candidate Network</span>
                </div>
            </div>

            <!-- Center Body: Dynamic Copy & Pillars -->
            <div class="left-center-body">
                <div class="left-badge" id="narrativeBadge">
                    <i class="fa-solid fa-sparkles"></i>
                    <span id="narrativeBadgeText">Verified Career Hub</span>
                </div>

                <h1 class="left-headline" id="narrativeHeadline">Your Next Career Move Starts Here</h1>
                <p class="left-description" id="narrativeDesc">
                    Discover verified roles from top tech and corporate employers. Track applications seamlessly and elevate your professional journey.
                </p>

                <!-- Value Proposition Highlights -->
                <div class="feature-pillars-list" id="pillarsList">
                    <div class="feature-pillar-item">
                        <div class="pillar-icon-box">
                            <i class="fa-solid fa-shield-halved" id="pillarIcon1"></i>
                        </div>
                        <div class="pillar-text-group">
                            <div class="pillar-title" id="pillarTitle1">100% Verified Job Postings</div>
                            <div class="pillar-sub" id="pillarSub1">Direct company hiring without intermediaries or spam</div>
                        </div>
                    </div>
                    <div class="feature-pillar-item">
                        <div class="pillar-icon-box">
                            <i class="fa-solid fa-bolt" id="pillarIcon2"></i>
                        </div>
                        <div class="pillar-text-group">
                            <div class="pillar-title" id="pillarTitle2">Real-Time Application Status</div>
                            <div class="pillar-sub" id="pillarSub2">Track when recruiters review, shortlist, and invite you</div>
                        </div>
                    </div>
                    <div class="feature-pillar-item">
                        <div class="pillar-icon-box">
                            <i class="fa-solid fa-comments" id="pillarIcon3"></i>
                        </div>
                        <div class="pillar-text-group">
                            <div class="pillar-title" id="pillarTitle3">Fast-Track Hiring Workflow</div>
                            <div class="pillar-sub" id="pillarSub3">Quick interview scheduling and status transparency</div>
                        </div>
                    </div>
                </div>

                <!-- Trust Statistics Row -->
                <div class="trust-stats-grid">
                    <div class="stat-box">
                        <div class="stat-number-val">10K+</div>
                        <div class="stat-title-lbl">Active Jobs</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number-val">500+</div>
                        <div class="stat-title-lbl">Verified Firms</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number-val">25K+</div>
                        <div class="stat-title-lbl">Professionals</div>
                    </div>
                </div>
            </div>

            <!-- Bottom Left Footer -->
            <div class="left-bottom-bar">
                <span>&copy; @DateTime.Now.Year JobNest Technologies.</span>
                <a href="mailto:support@jobnest.com">support@jobnest.com</a>
            </div>
        </aside>

        <!-- ==========================================
             RIGHT PANEL: Elevated Focused Auth Card
             ========================================== -->
        <main class="right-form-panel">

            <!-- Form Card Wrapper (Perfect Center Alignment) -->
            <div class="form-card-wrapper">
                <div class="auth-elevated-card">

                    <!-- Card Header -->
                    <div class="card-header-block">
                        <div class="portal-role-badge" id="cardBadge">
                            <i class="fa-solid fa-user" id="cardBadgeIcon"></i>
                            <span id="cardBadgeText">Candidate Gateway</span>
                        </div>
                        <h2 class="card-main-title" id="cardHeading">Welcome Back</h2>
                        <p class="card-sub-title" id="cardSubheading">Sign in to access your dashboard and active jobs.</p>
                    </div>

                    <!-- Role Switcher Grid (Candidate vs Employer) -->
                    <div class="role-switch-grid">
                        <button type="button" class="role-switch-tile active-candidate" id="tileCandidate" title="Sign in as Candidate">
                            <div class="tile-icon-avatar cand-avatar">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="tile-texts">
                                <div class="tile-name">Candidate</div>
                                <div class="tile-tag">Job Seeker</div>
                            </div>
                        </button>
                        <button type="button" class="role-switch-tile" id="tileCompany" title="Sign in as Employer">
                            <div class="tile-icon-avatar comp-avatar">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div class="tile-texts">
                                <div class="tile-name">Employer</div>
                                <div class="tile-tag">Hiring Team</div>
                            </div>
                        </button>
                    </div>

                    <!-- General Error Toast -->
                    @if (hasGeneralError)
                    {
                        <div class="auth-error-banner" id="errorBanner">
                            <div class="err-icon">
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </div>
                            <div class="err-content">
                                <div class="err-heading">Authentication Failed</div>
                                @Html.ValidationSummary(true, "")
                            </div>
                            <button type="button" class="btn-dismiss-err" id="btnDismissErr" title="Dismiss">&times;</button>
                        </div>
                    }

                    <!-- Controller Info Message -->
                    @if (Model != null && !string.IsNullOrEmpty(Model.msg))
                    {
                        <div class="auth-info-banner">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>@Model.msg</span>
                        </div>
                    }

                    <!-- Sign-In Form -->
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="selectedRole" id="selectedRoleInput" value="candidate" />

                        <!-- Username Field -->
                        <div class="field-unit">
                            <div class="field-label-line">
                                <label for="Username">Username</label>
                            </div>
                            <div class="field-input-box">
                                <span class="field-lead-icon"><i class="fa-solid fa-user"></i></span>
                                @Html.TextBoxFor(m => m.Username, new
                                {
                                    @class = "field-control",
                                    id = "Username",
                                    placeholder = "Enter your username",
                                    autocomplete = "username"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-validation-error" })
                        </div>

                        <!-- Password Field -->
                        <div class="field-unit">
                            <div class="field-label-line">
                                <label for="Password">Password</label>
                                <a href="javascript:void(0);" class="link-forgot-pass" id="btnTriggerForgot">Forgot Password?</a>
                            </div>
                            <div class="field-input-box">
                                <span class="field-lead-icon"><i class="fa-solid fa-lock"></i></span>
                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @class = "field-control",
                                    id = "Password",
                                    placeholder = "Enter your password",
                                    autocomplete = "current-password"
                                })
                                <button type="button" class="btn-eye-toggle" id="btnTogglePassword" tabindex="-1" title="Show or hide password" aria-label="Toggle password visibility">
                                    <i class="fa-solid fa-eye-slash" id="iconEye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                        </div>

                        <!-- Forgot Password Inline Assistance Card -->
                        <div class="forgot-help-card" id="forgotCard">
                            <button type="button" class="forgot-help-close" id="btnCloseForgotCard" title="Dismiss">&times;</button>
                            <div style="font-weight: 700; margin-bottom: 2px;">
                                <i class="fa-solid fa-circle-question" style="margin-right: 4px;"></i> Reset Credentials
                            </div>
                            <p style="margin: 0; font-size: 12px; color: #1e3a8a;">
                                Please contact your portal administrator or email
                                <a href="mailto:support@jobnest.com" style="color: #185adb; font-weight: 700; text-decoration: underline;">support@jobnest.com</a>
                                with your registered username.
                            </p>
                        </div>

                        <!-- Submit Action Button -->
                        <button type="submit" class="btn-action-submit" id="btnSubmit">
                            <span id="btnSubmitLabel">Sign In as Candidate</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    }

                    <!-- Registration Gateway -->
                    <div class="register-gateway-block">
                        <div class="register-prompt-lbl">Don't have a JobNest account yet?</div>
                        <div class="reg-action-buttons">
                            <a href="@Url.Action("AddEmployee", "Employee")" class="reg-tile-btn reg-cand">
                                <i class="fa-solid fa-user-plus"></i>
                                <span>Candidate Register</span>
                                <i class="fa-solid fa-arrow-right btn-arrow-arr"></i>
                            </a>
                            <a href="@Url.Action("AddCompany", "Company")" class="reg-tile-btn reg-comp">
                                <i class="fa-solid fa-building-circle-check"></i>
                                <span>Company Register</span>
                                <i class="fa-solid fa-arrow-right btn-arrow-arr"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Bottom Bar -->
            <div class="right-bottom-bar">
                <span>Protected by industry-grade encryption &bull; JobNest Portal</span>
            </div>

        </main>

    </div>

    <!-- ASP.NET MVC Bundles -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {

            // Role persistence using sessionStorage
            var savedRole = sessionStorage.getItem("jobnest_auth_role") || "candidate";
            var currentRole = savedRole;

            function applyRole(role) {
                currentRole = role;
                sessionStorage.setItem("jobnest_auth_role", role);
                $("#selectedRoleInput").val(role);

                if (role === "company") {
                    $("body").removeClass("role-candidate").addClass("role-company");

                    // Tile selection
                    $("#tileCandidate").removeClass("active-candidate active-company");
                    $("#tileCompany").removeClass("active-candidate").addClass("active-company");

                    // Right card copy
                    $("#btnSubmitLabel").text("Sign In as Employer");
                    $("#cardHeading").text("Employer Portal");
                    $("#cardSubheading").text("Sign in to publish job postings and manage candidate pipelines.");
                    $("#cardBadgeText").text("Recruiter Gateway");
                    $("#cardBadgeIcon").removeClass("fa-user").addClass("fa-building");

                    // Left panel copy
                    $("#statusPortalText").text("Employer Network");
                    $("#narrativeBadgeText").text("Enterprise Hiring Suite");
                    $("#narrativeHeadline").text("Build & Scale Your High-Performing Team");
                    $("#narrativeDesc").text("Access top-tier pre-vetted candidates. Post openings, manage talent pipelines, and hire with confidence.");

                    // Left pillars
                    $("#pillarIcon1").attr("class", "fa-solid fa-magnifying-glass-chart");
                    $("#pillarTitle1").text("Targeted Talent Search");
                    $("#pillarSub1").text("Filter vetted candidates by precise skills and experience");

                    $("#pillarIcon2").attr("class", "fa-solid fa-sliders");
                    $("#pillarTitle2").text("Candidate Pipeline Manager");
                    $("#pillarSub2").text("Review resumes and shortlist candidates in one unified place");

                    $("#pillarIcon3").attr("class", "fa-solid fa-id-badge");
                    $("#pillarTitle3").text("Employer Brand Showcase");
                    $("#pillarSub3").text("Attract top professionals to your company culture");
                } else {
                    $("body").removeClass("role-company").addClass("role-candidate");

                    // Tile selection
                    $("#tileCompany").removeClass("active-candidate active-company");
                    $("#tileCandidate").removeClass("active-company").addClass("active-candidate");

                    // Right card copy
                    $("#btnSubmitLabel").text("Sign In as Candidate");
                    $("#cardHeading").text("Welcome Back");
                    $("#cardSubheading").text("Sign in to access your dashboard and active jobs.");
                    $("#cardBadgeText").text("Candidate Gateway");
                    $("#cardBadgeIcon").removeClass("fa-building").addClass("fa-user");

                    // Left panel copy
                    $("#statusPortalText").text("Candidate Network");
                    $("#narrativeBadgeText").text("Verified Career Hub");
                    $("#narrativeHeadline").text("Your Next Career Move Starts Here");
                    $("#narrativeDesc").text("Discover verified roles from top tech and corporate employers. Track applications seamlessly and elevate your career.");

                    // Left pillars
                    $("#pillarIcon1").attr("class", "fa-solid fa-shield-halved");
                    $("#pillarTitle1").text("100% Verified Job Postings");
                    $("#pillarSub1").text("Direct company hiring without intermediaries or spam");

                    $("#pillarIcon2").attr("class", "fa-solid fa-bolt");
                    $("#pillarTitle2").text("Real-Time Application Status");
                    $("#pillarSub2").text("Track when recruiters review, shortlist, and invite you");

                    $("#pillarIcon3").attr("class", "fa-solid fa-comments");
                    $("#pillarTitle3").text("Fast-Track Hiring Workflow");
                    $("#pillarSub3").text("Quick interview scheduling and status transparency");
                }
            }

            // Apply initially
            applyRole(savedRole);

            // Role selection events
            $("#tileCandidate").on("click", function () { applyRole("candidate"); });
            $("#tileCompany").on("click", function () { applyRole("company"); });

            // Password eye toggle
            $("#btnTogglePassword").on("click", function (e) {
                e.preventDefault();
                var pwd = $("#Password");
                var icon = $("#iconEye");
                if (pwd.attr("type") === "password") {
                    pwd.attr("type", "text");
                    icon.removeClass("fa-eye-slash").addClass("fa-eye");
                } else {
                    pwd.attr("type", "password");
                    icon.removeClass("fa-eye").addClass("fa-eye-slash");
                }
            });

            // Forgot password help toggle
            $("#btnTriggerForgot").on("click", function (e) {
                e.preventDefault();
                $("#forgotCard").slideToggle(200);
            });

            $("#btnCloseForgotCard").on("click", function () {
                $("#forgotCard").slideUp(200);
            });

            // Dismiss error banner
            $("#btnDismissErr").on("click", function () {
                $(this).closest(".auth-error-banner").slideUp(200);
            });
        });
    </script>
</body>
</html>
