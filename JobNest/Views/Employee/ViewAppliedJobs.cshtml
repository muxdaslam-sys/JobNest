
@model IEnumerable<JobNest.Models.AppliedJobs>
@{
    ViewBag.Title = "My Applied Jobs";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    var appliedList = Model != null ? Model.ToList() : new List<JobNest.Models.AppliedJobs>();
    int totalCount = appliedList.Count;
    int pendingCount = appliedList.Count(x => string.Equals(x.ApplicationStatus, "Applied", StringComparison.OrdinalIgnoreCase));
    int shortlistedCount = appliedList.Count(x => string.Equals(x.ApplicationStatus, "Shortlisted", StringComparison.OrdinalIgnoreCase));
    int rejectedCount = appliedList.Count(x => string.Equals(x.ApplicationStatus, "Rejected", StringComparison.OrdinalIgnoreCase));
}

@section styles {
    <style>
        .page-header-section {
            background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%);
            color: #ffffff;
            padding: 38px 0 44px 0;
            box-shadow: 0 4px 20px rgba(6, 78, 59, 0.12);
        }

        .page-header-title {
            font-size: 26px;
            font-weight: 800;
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

        .page-header-subtitle {
            font-size: 14px;
            color: #a7f3d0;
            margin: 0;
        }

        .stats-bar {
            display: flex;
            gap: 16px;
            margin-top: -24px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 140px;
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 16px 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .stat-icon.total {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.pending {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.shortlisted {
            background: #f0fdf4;
            color: #16a34a;
        }

        .stat-icon.rejected {
            background: #fef2f2;
            color: #dc2626;
        }

        .stat-val {
            font-size: 20px;
            font-weight: 800;
            color: var(--dark-heading);
            line-height: 1.2;
        }

        .stat-lbl {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .applications-card {
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            margin-bottom: 60px;
        }

        .table-custom {
            width: 100%;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table-custom th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 18px 24px;
            border-bottom: 1px solid var(--border-subtle);
            border-top: none;
            vertical-align: middle !important;
        }

        .table-custom td {
            padding: 24px 24px;
            vertical-align: middle !important;
            border-bottom: 1px solid var(--border-subtle);
            font-size: 14px;
        }

        .table-custom tr:last-child td {
            border-bottom: none;
        }

        .table-custom tbody tr:hover {
            background-color: #f8fafc;
        }

        .job-title-text {
            font-weight: 700;
            color: var(--dark-heading);
            font-size: 15.5px;
            line-height: 1.4;
            margin-bottom: 6px;
        }

        .company-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--text-muted);
            font-size: 13.5px;
            font-weight: 500;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-applied {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .status-shortlisted {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }

        .status-rejected {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .status-other {
            background: #f8fafc;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .btn-resume-download {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            color: #334155;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s;
        }

        .btn-resume-download:hover {
            background: #e2e8f0;
            color: var(--dark-heading);
            text-decoration: none;
        }

        .empty-state-box {
            text-align: center;
            padding: 60px 20px;
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            margin-bottom: 40px;
        }

        .empty-icon-wrap {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #ecfdf5;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 18px auto;
        }

        .empty-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--dark-heading);
            margin-bottom: 8px;
        }

        .empty-desc {
            color: var(--text-muted);
            font-size: 14px;
            max-width: 420px;
            margin: 0 auto 22px auto;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header-section">
    <div class="container">
        <h1 class="page-header-title"><i class="fa-solid fa-file-circle-check" style="margin-right: 10px;"></i> My Applied Jobs</h1>
        <p class="page-header-subtitle">Review all your job applications and stay updated on your current status.</p>
    </div>
</div>

<div class="container" style="margin-top: 10px;">
    <!-- Stats Bar -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fa-solid fa-paper-plane"></i>
            </div>
            <div>
                <div class="stat-val">@totalCount</div>
                <div class="stat-lbl">Total Applied</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div>
                <div class="stat-val">@pendingCount</div>
                <div class="stat-lbl">Under Review</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon shortlisted">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="stat-val">@shortlistedCount</div>
                <div class="stat-lbl">Shortlisted</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon rejected">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div>
                <div class="stat-val">@rejectedCount</div>
                <div class="stat-lbl">Archived</div>
            </div>
        </div>
    </div>

    <!-- Applications Table or Empty State -->
    @if (appliedList.Count == 0)
    {
        <div class="empty-state-box">
            <div class="empty-icon-wrap">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <div class="empty-title">No applications yet</div>
            <p class="empty-desc">You haven't applied to any job postings yet. Explore open roles that match your skills and experience to submit your application.</p>
            <a href="@Url.Action("Index", "Employee")" class="btn btn-success" style="background-color: var(--primary); border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600;">
                <i class="fa-solid fa-magnifying-glass" style="margin-right: 6px;"></i> Browse Open Jobs
            </a>
        </div>
    }
    else
    {
        <div class="applications-card">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th style="width: 36%;">Job &amp; Company</th>
                            <th style="width: 22%;">Location</th>
                            <th style="width: 18%;">Applied Date</th>
                            <th style="width: 13%;">Status</th>
                            <th style="width: 11%; text-align: center;">Resume</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in appliedList)
                        {
                            var statusLower = (item.ApplicationStatus ?? "").ToLower();
                            var badgeClass = "status-other";
                            var iconClass = "fa-regular fa-circle-question";

                            if (statusLower == "applied" || statusLower == "pending")
                            {
                                badgeClass = "status-applied";
                                iconClass = "fa-solid fa-paper-plane";
                            }
                            else if (statusLower == "shortlisted" || statusLower == "accepted" || statusLower == "approved")
                            {
                                badgeClass = "status-shortlisted";
                                iconClass = "fa-solid fa-circle-check";
                            }
                            else if (statusLower == "rejected")
                            {
                                badgeClass = "status-rejected";
                                iconClass = "fa-solid fa-circle-xmark";
                            }

                            <tr>
                                <td>
                                    <div class="job-title-text">
                                        @item.JobTitle
                                    </div>
                                    <div class="company-pill">
                                        <i class="fa-regular fa-building" style="color: #94a3b8;"></i> @item.CompanyName
                                    </div>
                                </td>
                                <td>
                                    <span style="color: var(--text-main); font-weight: 500;">
                                        <i class="fa-solid fa-location-dot" style="color: #94a3b8; margin-right: 6px;"></i>
                                        @(string.IsNullOrWhiteSpace(item.JobLocation) ? "Not Specified" : item.JobLocation)
                                    </span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--dark-heading);">
                                        @(item.ApplicationDate.HasValue ? item.ApplicationDate.Value.ToString("dd MMM yyyy") : "N/A")
                                    </div>
                                    
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass">
                                        <i class="@iconClass"></i> @(item.ApplicationStatus ?? "Applied")
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @if (!string.IsNullOrWhiteSpace(item.ResumePath))
                                    {
                                        <a href="@Url.Content(item.ResumePath)" target="_blank" class="btn-resume-download" title="Download or view submitted resume">
                                            <i class="fa-solid fa-file-arrow-down" style="color: var(--primary);"></i> Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-size: 12px;">No File</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
